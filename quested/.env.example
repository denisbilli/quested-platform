# Copy to `.env` and fill in. Never commit `.env`.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# Never enable in production.
DEBUG=True

# Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1

# Required behind a reverse proxy on a custom domain, e.g.
# CSRF_TRUSTED_ORIGINS=https://quiz.example.com
CSRF_TRUSTED_ORIGINS=

# sqlite:///absolute/path/db.sqlite3  |  postgres://user:pass@host:5432/dbname
# Defaults to the project-local SQLite file when unset.
# DATABASE_URL=

# Production hardening: enable once HTTPS is in front of the app.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Max submission upload size, in bytes (default 5 MiB).
MAX_UPLOAD_SIZE=5242880
