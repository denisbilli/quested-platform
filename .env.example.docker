# Copy to `.env` next to docker-compose.yml. Never commit it.
# Generate the key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Defaults to SQLite on the quested-data volume.
# DATABASE_URL=postgres://quested:CHANGE_ME@db:5432/quested

LOG_LEVEL=INFO

# Turn both on once HTTPS is in front of the app.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
